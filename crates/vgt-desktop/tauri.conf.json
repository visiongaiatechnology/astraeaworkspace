{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astraea Workspace Open Core",
  "version": "0.1.0-alpha.1",
  "identifier": "technology.visiongaia.astraea.workspace.opencore",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev -- --mode open-core",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build:open-core",
      "cwd": "../../ui"
    },
    "frontendDist": "../../ui/dist/open-core"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Astraea Workspace Alpha 0.1",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Sovereign local-first productivity suite",
    "longDescription": "Astraea Workspace Beta is a local-first productivity suite with encrypted native containers and no required cloud account.",
    "fileAssociations": [
      {
        "ext": [
          "vwc"
        ],
        "name": "Astraea Workspace Container",
        "description": "Encrypted Astraea Workspace container",
        "role": "Editor",
        "mimeType": "application/x-astraea-vwc",
        "exportedType": {
          "identifier": "technology.visiongaia.astraea.vwc",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "vdoc"
        ],
        "name": "Astraea Writer Document",
        "description": "Encrypted Astraea Writer document",
        "role": "Editor",
        "mimeType": "application/x-astraea-vdoc",
